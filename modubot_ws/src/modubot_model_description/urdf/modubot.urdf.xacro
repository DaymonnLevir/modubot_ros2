<?xml version="1.0"?>
<robot name="modubot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://modubot_model_description/meshes/base.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- Frame do LiDAR (ajuste xyz para a posição real) -->
  <link name="laser"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.20 0.0 0.15" rpy="0 0 0"/>
  </joint>

</robot>
